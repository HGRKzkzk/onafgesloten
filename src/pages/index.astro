---
import SiteLayout from '../layouts/SiteLayout.astro';
import { chapters } from '../data/chapters';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const publicChapters = chapters.filter(
  (chapter) => chapter.slug !== 'vooraf'
);
---

<SiteLayout title="Onafgesloten">
  <main class="home">

    <section class="home-intro">
      <h1>Onafgesloten</h1>

      <p>
        Onafgesloten is een filosofische verkenning van hoe levende,
        relationele en institutionele vormen samenhang bewaren terwijl
        zij veranderlijk, afhankelijk en corrigeerbaar blijven.
      </p>
    </section>

    <section
      class="home-route"
      aria-label="Hoofdstukken"
    >
      <div class="home-chapters">
        {publicChapters.map((chapter, index) => {
          const number = String(index + 1).padStart(2, '0');

          return (
            <a
              class="home-chapter"
              href={`${base}/hoofdstukken/${chapter.slug}/`}
            >
              <span class="home-chapter__number">
                {number}
              </span>

              <span class="home-chapter__body">
                <span class="home-chapter__title">
                  {chapter.title}
                </span>

                {chapter.description && (
                  <span class="home-chapter__description">
                    {chapter.description}
                  </span>
                )}
              </span>
            </a>
          );
        })}
      </div>
    </section>

  </main>
</SiteLayout>
