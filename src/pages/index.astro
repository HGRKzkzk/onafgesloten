---
import SiteLayout from '../layouts/SiteLayout.astro';
import { chapters } from '../data/chapters';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const publicChapters = chapters.filter(
  (chapter) => chapter.slug !== 'vooraf'
);

const vooraf = chapters.find(
  (chapter) => chapter.slug === 'vooraf'
);
---

<SiteLayout title="Onafgesloten">
  <main class="home">

    <section class="home-hero">
      <div
        class="home-hero__field"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 1200 720"
          preserveAspectRatio="xMidYMid slice"
        >
          <path
            d="M-80 510 C 180 300, 330 610, 570 420 S 920 180, 1280 360"
          />
          <path
            d="M-120 370 C 120 570, 360 190, 610 340 S 940 590, 1300 260"
          />
          <path
            d="M70 760 C 260 520, 510 690, 720 470 S 980 250, 1160 -40"
          />
          <path
            d="M250 -80 C 330 160, 530 140, 650 310 S 760 570, 1030 730"
          />
        </svg>
      </div>

      <div class="home-hero__content">
        <p class="home-kicker">
          Een filosofische verkenning
        </p>

        <h1>Onafgesloten</h1>

        <p class="home-hero__statement">
          Wat verschijnt, verschijnt onaf.
        </p>

        {vooraf && (
          <a
            class="home-start"
            href={`${base}/hoofdstukken/${vooraf.slug}/`}
          >
            Begin bij het vooraf
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </section>

    <section
      class="home-opening"
      aria-labelledby="home-opening-title"
    >
      <p class="home-opening__eyebrow">
        Waar dit begint
      </p>

      <div class="home-opening__moments">
        <p class="home-opening__moment">
          Je denkt te weten wie iemand is.
          <span>
            Tot diegene iets doet wat niet in je beeld past.
          </span>
        </p>

        <p class="home-opening__moment home-opening__moment--shift">
          Je denkt te weten wie je zelf bent.
          <span>
            Tot je jezelf verrast.
          </span>
        </p>
      </div>

      <div class="home-opening__bridge">
        <p>
          Een naam kan iets zichtbaar maken. Een grens kan beschermen.
          Een verhaal kan samenhang geven.
        </p>

        <p>
          En soms wordt precies datgene wat hielp om iets te zien
          de reden dat we niet meer verder kijken.
        </p>
      </div>

      <div class="home-opening__landing">
        <h2 id="home-opening-title">
          Onafgesloten begint daar.
        </h2>

        <p>
          Niet met de gedachte dat vormen moeten verdwijnen,
          maar met de vraag hoe iets werkelijk zichzelf kan zijn
          zonder voorgoed vast te liggen.
        </p>
      </div>
    </section>

    <section
      class="home-route"
      aria-labelledby="home-route-title"
    >
      <header class="home-route__header">
        <p class="home-route__eyebrow">
          Leesroute
        </p>

        <h2 id="home-route-title">
          Hoofdstukken
        </h2>

        <p>
          Je kunt van voor naar achter lezen. Je kunt ook ergens
          binnenvallen en vandaar verder kijken. De hoofdstukken
          staan op zichzelf en blijven tegelijk met elkaar in gesprek.
        </p>
      </header>

      <div class="home-chapters">
        {publicChapters.map((chapter, index) => {
          const number = String(index + 1).padStart(2, '0');

          return (
            <a
              class="home-chapter"
              href={`${base}/hoofdstukken/${chapter.slug}/`}
            >
              <span class="home-chapter__number">
                {number}
              </span>

              <span class="home-chapter__body">
                <span class="home-chapter__title">
                  {chapter.title}
                </span>

                {chapter.description && (
                  <span class="home-chapter__description">
                    {chapter.description}
                  </span>
                )}
              </span>

              <span
                class="home-chapter__arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="home-closing">
      <p>
        Soms moet iets begrensd worden. Soms juist opnieuw geopend.
        De vraag is niet hoe we zonder vormen leven, maar hoe we merken
        wanneer een vorm niet meer antwoordt op wat er werkelijk gebeurt.
      </p>

      {vooraf && (
        <a
          href={`${base}/hoofdstukken/${vooraf.slug}/`}
        >
          Begin met lezen
          <span aria-hidden="true">→</span>
        </a>
      )}
    </section>

  </main>
</SiteLayout>